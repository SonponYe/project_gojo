# Copy to `.env` and fill in. All EXPO_PUBLIC_* vars are inlined at build time.

# From Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: a MapLibre style JSON URL (MapTiler, Protomaps, self-hosted…).
# Defaults to the free MapLibre demo tiles if unset.
# EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY

# Optional: EAS project id — required for Expo push tokens on a device build.
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# NOTE: the service_role key and the Postgres connection string are NOT used by
# the app and must never live in this file. Keep them somewhere private and use
# them only for applying migrations / deploying edge functions.
